/**
 * Enhanced WhatsApp Tracking for LCCL Trial Pages
 * Tracks source attribution and provides better conversion data
 */

// Generate unique click ID for tracking
function generateClickId() {
    return Date.now().toString(36) + Math.random().toString(36).substr(2, 5);
}

// Get program name from current page
function getCurrentProgram() {
    const path = window.location.pathname;
    if (path.includes('early-creators')) return 'early-creators';
    if (path.includes('coding-fundamentals')) return 'coding-fundamentals';
    if (path.includes('python')) return 'python';
    return 'general';
}

// Build enhanced WhatsApp message with tracking
function getWhatsAppMessage(program) {
    const messages = {
        'early-creators': "Hi! I'm interested in the Early Creators trial class for my 5-6 year old.",
        'coding-fundamentals': "Hi! I'm interested in the Coding Fundamentals trial class for my 8-11 year old.",
        'python': "Hi! I'm interested in the Python trial class for my 12-18 year old.",
        'general': "Hi! I'm interested in the coding trial class for my child."
    };

    let message = messages[program] || messages.general;

    // Add tracking info
    const clickId = generateClickId();
    const utm_source = sessionStorage.getItem('utm_source') ||
                      new URLSearchParams(window.location.search).get('utm_source');

    // Add reference code
    message += ` [Ref: ${clickId}]`;

    // Add source if from ads
    if (utm_source && utm_source !== 'direct') {
        message += ` (Via: ${utm_source})`;
    }

    return message;
}

// Enhanced tracking function
function trackWhatsAppClick(element) {
    const program = getCurrentProgram();
    const clickId = generateClickId();

    // Get all tracking parameters
    const trackingData = {
        'event': 'whatsapp_click',
        'click_id': clickId,
        'program': program,
        'utm_source': sessionStorage.getItem('utm_source') || 'direct',
        'utm_medium': sessionStorage.getItem('utm_medium') || 'none',
        'utm_campaign': sessionStorage.getItem('utm_campaign') || 'none',
        'landing_page': window.location.pathname,
        'page_title': document.title,
        'timestamp': new Date().toISOString(),
        'device': /Mobile|Android|iPhone/i.test(navigator.userAgent) ? 'mobile' : 'desktop'
    };

    // Push to dataLayer for GTM
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(trackingData);

    // Track in GA4
    if (typeof gtag !== 'undefined') {
        gtag('event', 'contact', {
            'contact_method': 'whatsapp',
            'program': program,
            'click_id': clickId,
            'value': program === 'early-creators' ? 10 : 15,
            'currency': 'SGD'
        });
    }

    // Store click ID in session for later reference
    sessionStorage.setItem('whatsapp_click_id', clickId);
    sessionStorage.setItem('whatsapp_click_time', Date.now());

    // Update the WhatsApp link with enhanced message
    const message = getWhatsAppMessage(program);
    element.href = `https://wa.me/6591249338?text=${encodeURIComponent(message)}`;

    console.log('WhatsApp tracking:', trackingData);
}

// Initialize WhatsApp buttons on page load
document.addEventListener('DOMContentLoaded', function() {
    // Find all WhatsApp links
    const whatsappLinks = document.querySelectorAll('a[href*="wa.me"]');

    whatsappLinks.forEach(link => {
        // Add click handler
        link.addEventListener('click', function(e) {
            // Don't prevent default - let link work normally
            trackWhatsAppClick(this);

            // Small delay to ensure tracking fires
            setTimeout(() => {
                // Link will open naturally
            }, 100);
        });

        // Update message on page load with tracking info
        const program = getCurrentProgram();
        const message = getWhatsAppMessage(program);
        link.href = `https://wa.me/6591249338?text=${encodeURIComponent(message)}`;
    });
});

// Export functions for manual use
window.LCCLWhatsApp = {
    track: trackWhatsAppClick,
    getMessage: getWhatsAppMessage,
    getClickId: generateClickId
};